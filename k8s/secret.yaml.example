apiVersion: v1
kind: Secret
metadata:
  name: fuenfgiebel-secrets
  namespace: fuenfgiebel
  labels:
    app.kubernetes.io/name: fuenfgiebel
type: Opaque
stringData:
  # Generate hash with: node -e "const argon2=require('argon2');argon2.hash('your-password').then(console.log)"
  ADMIN_PASSWORD_HASH: "REPLACE_WITH_ARGON2_HASH"
  # Optional: For Voice-to-Publish feature (Phase 7)
  # OPENAI_API_KEY: ""
  # ANTHROPIC_API_KEY: ""
