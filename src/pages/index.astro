---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EntryCard from '@/components/EntryCard.astro';
import PaintSplatter from '@/components/PaintSplatter.astro';
import { getLatestEntries } from '@/lib/services/entries';

const latestEntries = await getLatestEntries(3);

const categories = [
  {
    href: '/restaurants',
    title: 'Restaurants',
    description: 'Die besten Lokale in und um Lüneburg, bewertet nach Service, Essen, Ambiente und Preis-Leistung.',
    icon: 'restaurant',
    accentColor: 'magenta',
  },
  {
    href: '/kunst',
    title: 'Kunst',
    description: 'Ausstellungen und Museen, die uns begeistert haben.',
    icon: 'art',
    accentColor: 'gold',
  },
  {
    href: '/touren',
    title: 'Touren',
    description: 'Wander- und Radtouren in der Lüneburger Heide und darüber hinaus.',
    icon: 'tour',
    accentColor: 'olive',
  },
];
---

<BaseLayout title="Startseite">
  <!-- Hero Section - Expressionist inspired -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden">
    <!-- Abstract background layers -->
    <div class="absolute inset-0 -z-10">
      <!-- Large olive/brown shape (center of painting) -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[500px] rounded-[40%_60%_70%_30%/40%_50%_60%_50%] bg-olive/[0.07] blur-3xl"></div>

      <!-- Gold highlights -->
      <div class="absolute top-1/3 right-1/4 w-40 h-48 rounded-[30%_70%_70%_30%/30%_30%_70%_70%] bg-gold/[0.12] blur-2xl"></div>
      <div class="absolute bottom-1/4 left-1/3 w-32 h-36 rounded-[60%_40%_30%_70%/60%_30%_70%_40%] bg-gold/[0.08] blur-2xl"></div>

      <!-- Sand/cream washes -->
      <div class="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-sand/10 to-transparent"></div>
      <div class="absolute bottom-0 right-0 w-2/3 h-1/3 bg-gradient-to-tl from-sand/15 to-transparent"></div>

      <!-- Horizontal texture lines (spatula effect) -->
      <div class="absolute inset-0 opacity-[0.03]" style="background: repeating-linear-gradient(0deg, transparent, transparent 3px, currentColor 3px, currentColor 4px);"></div>
    </div>

    <!-- Paint splatters -->
    <PaintSplatter intensity="bold" position="full" class="opacity-60" />

    <div class="container relative py-20 md:py-32">
      <div class="max-w-4xl">
        <!-- Tagline with brush underline -->
        <p class="mb-6 text-sm font-medium uppercase tracking-[0.2em] text-olive opacity-0 animate-fade-up">
          Lüneburg & Umgebung
        </p>

        <!-- Main headline - expressive typography -->
        <h1 class="font-serif text-display-lg font-semibold tracking-tight md:text-display-xl opacity-0 animate-fade-up stagger-1">
          <span class="block">Genuss, Kultur</span>
          <span class="block">&amp; Natur</span>
          <span class="relative inline-block mt-2">
            <span class="brush-underline text-primary">erleben</span>
          </span>
        </h1>

        <!-- Description -->
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted-foreground opacity-0 animate-fade-up stagger-2">
          Unsere persönlichen Empfehlungen zu Restaurants, Kunstausstellungen und Wandertouren –
          <span class="text-foreground font-medium">ehrlich bewertet</span> mit Lüneburger Giebeln.
        </p>

        <!-- CTA buttons -->
        <div class="mt-12 flex flex-wrap items-center gap-4 opacity-0 animate-fade-up stagger-3">
          <a
            href="/restaurants"
            class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-primary px-8 py-4 text-sm font-medium text-primary-foreground shadow-lg transition-all hover:shadow-xl hover:scale-[1.02]"
          >
            <span class="relative z-10">Entdecken</span>
            <svg class="relative z-10 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
            <!-- Shine effect -->
            <span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-700 group-hover:translate-x-full"></span>
          </a>
          <a
            href="#latest"
            class="inline-flex items-center gap-2 rounded-full border-2 border-olive/30 bg-transparent px-8 py-4 text-sm font-medium text-foreground transition-all hover:border-olive/50 hover:bg-olive/5"
          >
            Neueste Einträge
          </a>
        </div>
      </div>

      <!-- Decorative side element -->
      <div class="hidden lg:block absolute right-0 top-1/2 -translate-y-1/2 w-px h-40 bg-gradient-to-b from-transparent via-magenta/40 to-transparent"></div>
    </div>
  </section>

  <!-- Artistic divider -->
  <div class="relative h-24 overflow-hidden">
    <div class="absolute inset-x-0 top-1/2 h-px bg-border"></div>
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center gap-3 bg-background px-6">
      <span class="h-2 w-2 rounded-full bg-magenta/60"></span>
      <span class="h-1.5 w-1.5 rounded-full bg-gold/60"></span>
      <span class="h-2 w-2 rounded-full bg-olive/40"></span>
    </div>
  </div>

  <!-- Latest Entries -->
  <section id="latest" class="container py-16 md:py-24">
    <div class="mb-12 flex items-end justify-between">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-magenta">
          Frisch hinzugefügt
        </p>
        <h2 class="font-serif text-display-sm font-semibold md:text-display-md">
          Neueste Einträge
        </h2>
      </div>
      <a
        href="/restaurants"
        class="hidden items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-magenta sm:flex"
      >
        Alle ansehen
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    {latestEntries.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {latestEntries.map((entry, index) => (
          <div class={`opacity-0 animate-fade-up stagger-${index + 1}`}>
            <EntryCard entry={entry} showCategory />
          </div>
        ))}
      </div>
    ) : (
      <div class="relative overflow-hidden rounded-2xl border border-dashed border-olive/30 bg-sand-light/30 p-16 text-center">
        <PaintSplatter intensity="subtle" position="full" class="opacity-30" />
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          class="mx-auto h-16 w-16 text-olive/30"
        >
          <path d="M12 3L2 12h3v8h14v-8h3L12 3z" />
          <path d="M9 20v-6h6v6" />
        </svg>
        <p class="mt-6 text-muted-foreground">
          Noch keine Einträge vorhanden. Die ersten Reviews kommen bald!
        </p>
      </div>
    )}
  </section>

  <!-- Artistic divider -->
  <div class="relative h-24 overflow-hidden">
    <div class="absolute inset-x-0 top-1/2 h-px bg-border"></div>
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center gap-2 bg-background px-6">
      <span class="h-1 w-8 rounded-full bg-gradient-to-r from-magenta/60 to-gold/40"></span>
    </div>
  </div>

  <!-- Categories - Gallery style -->
  <section class="container py-16 md:py-24">
    <div class="mb-12 text-center">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-gold">
        Stöbern nach
      </p>
      <h2 class="font-serif text-display-sm font-semibold md:text-display-md">
        Kategorien
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {categories.map((category, index) => (
        <a
          href={category.href}
          class={`group relative overflow-hidden rounded-2xl border bg-card p-8 transition-all duration-500 hover:-translate-y-2 hover:shadow-xl opacity-0 animate-fade-up stagger-${index + 1}`}
        >
          <!-- Accent color splash -->
          <div class={`absolute -right-12 -top-12 h-40 w-40 rounded-full bg-${category.accentColor}/10 blur-2xl transition-all duration-500 group-hover:scale-150 group-hover:bg-${category.accentColor}/15`}></div>

          <!-- Icon with accent border -->
          <div class={`relative mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl border-2 border-${category.accentColor}/20 bg-${category.accentColor}-light transition-colors group-hover:border-${category.accentColor}/40`}>
            {category.icon === 'restaurant' && (
              <svg class="h-8 w-8 text-magenta" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.055 4.024.165C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m15-3.379a48.474 48.474 0 00-6-.371c-2.032 0-4.034.126-6 .371m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.169c0 .621-.504 1.125-1.125 1.125H4.125A1.125 1.125 0 013 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 016 13.12M12 8.25v.75" />
              </svg>
            )}
            {category.icon === 'art' && (
              <svg class="h-8 w-8 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
              </svg>
            )}
            {category.icon === 'tour' && (
              <svg class="h-8 w-8 text-olive" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            )}
          </div>

          <!-- Content -->
          <h3 class="mb-3 font-serif text-2xl font-semibold transition-colors group-hover:text-primary">
            {category.title}
          </h3>
          <p class="text-sm leading-relaxed text-muted-foreground">
            {category.description}
          </p>

          <!-- Arrow with paint accent -->
          <div class="mt-8 flex items-center gap-3">
            <span class={`h-1 w-0 rounded-full bg-${category.accentColor} transition-all duration-300 group-hover:w-8`}></span>
            <span class="text-sm font-medium text-primary opacity-0 transition-all duration-300 group-hover:opacity-100">
              Erkunden
            </span>
            <svg class="h-4 w-4 text-primary opacity-0 transition-all duration-300 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Bottom spacer -->
  <div class="h-16 md:h-24"></div>
</BaseLayout>
