---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GableRating } from '@/components/GableRating';
import { getEntry } from '@/lib/services/entries';
import type { TourEntry } from '@/lib/types';

const { slug } = Astro.params;
const entry = await getEntry('tour', slug!) as TourEntry | null;

if (!entry || entry.status !== 'active') {
  return Astro.redirect('/touren');
}

// Format date in German
const dateFormatter = new Intl.DateTimeFormat('de-DE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const formattedDate = dateFormatter.format(new Date(entry.date));

// Difficulty labels and colors
const difficultyLabels = {
  leicht: 'Leicht',
  mittel: 'Mittel',
  schwer: 'Schwer',
};

const difficultyColors = {
  leicht: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  mittel: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
  schwer: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
};

// SEO data
const ogImage = entry.images?.[0]
  ? `/api/images/touren/${entry.slug}/${entry.images[0]}`
  : undefined;
const details = [
  entry.distance_km && `${entry.distance_km} km`,
  entry.duration,
  entry.difficulty && difficultyLabels[entry.difficulty],
].filter(Boolean).join(', ');
const seoDescription = `${entry.name} - Tour mit ${entry.rating} Giebeln bewertet.${details ? ` ${details}.` : ''}`;
---

<BaseLayout
  title={entry.name}
  description={seoDescription}
  image={ogImage}
  type="article"
  publishedTime={entry.date}
>
  <article class="container py-8 md:py-12">
    <div class="mb-8">
      <a
        href="/touren"
        class="inline-flex items-center text-sm text-muted-foreground hover:text-foreground"
      >
        ← Zurück zu Touren
      </a>
    </div>

    <header class="mb-8">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        {entry.difficulty && (
          <span class={`rounded-full px-3 py-1 text-sm font-medium ${difficultyColors[entry.difficulty]}`}>
            {difficultyLabels[entry.difficulty]}
          </span>
        )}
        <time class="text-sm text-muted-foreground" datetime={entry.date}>
          {formattedDate}
        </time>
      </div>
      <h1 class="mb-4 text-4xl font-bold">{entry.name}</h1>
      <div class="flex items-center gap-3">
        <GableRating client:load rating={entry.rating} size="lg" showValue />
      </div>
    </header>

    <div class="mb-8 flex flex-wrap gap-6">
      {entry.distance_km && (
        <div>
          <span class="block text-sm text-muted-foreground">Distanz</span>
          <span class="text-lg font-medium">{entry.distance_km} km</span>
        </div>
      )}
      {entry.duration && (
        <div>
          <span class="block text-sm text-muted-foreground">Dauer</span>
          <span class="text-lg font-medium">{entry.duration}</span>
        </div>
      )}
    </div>

    {entry.images && entry.images.length > 0 && (
      <div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {entry.images.map((image, index) => (
          <div class="aspect-video overflow-hidden rounded-lg bg-muted">
            <img
              src={`/api/images/touren/${entry.slug}/${image}`}
              alt={`${entry.name} - Bild ${index + 1}`}
              class="h-full w-full object-cover"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>
    )}

    {entry.htmlContent && (
      <div class="prose prose-neutral max-w-none dark:prose-invert">
        <Fragment set:html={entry.htmlContent} />
      </div>
    )}

    {entry.link && (
      <div class="mt-8 border-t pt-8">
        <a
          href={entry.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center text-sm text-primary hover:underline"
        >
          Mehr Informationen →
        </a>
      </div>
    )}
  </article>
</BaseLayout>
