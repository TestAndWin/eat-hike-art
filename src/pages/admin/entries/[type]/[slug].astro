---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { EntryForm } from '@/components/admin/EntryForm';
import { ImageUploadSection } from '@/components/admin/ImageUploadSection';
import { getEntry } from '@/lib/services/entries';
import { requireAuth } from '@/lib/services/auth';
import { CATEGORY_PATHS } from '@/lib/types';
import type { Entry } from '@/lib/types';

// Check authentication first
const isAuthenticated = await requireAuth(Astro.cookies);
if (!isAuthenticated) {
  return Astro.redirect('/admin/login');
}

const { type, slug } = Astro.params;

// Map URL path to entry type
const entryType = type as Entry['type'];

// Validate type
if (!['restaurant', 'art', 'tour'].includes(entryType)) {
  return Astro.redirect('/admin/entries');
}

// Get entry
const entry = await getEntry(entryType, slug!);

if (!entry) {
  return Astro.redirect('/admin/entries');
}

const typeLabels = {
  restaurant: 'Restaurant',
  art: 'Kunst',
  tour: 'Tour',
};
---

<AdminLayout title={`${entry.name} bearbeiten`}>
  <div class="mx-auto max-w-3xl">
    <div class="mb-8 flex items-center justify-between">
      <a
        href="/admin/entries"
        class="inline-flex items-center text-sm text-muted-foreground hover:text-foreground"
      >
        ← Zurück zu Einträge
      </a>
      <div class="flex items-center gap-2">
        <a
          href={`/${CATEGORY_PATHS[entry.type]}/${entry.slug}`}
          target="_blank"
          class="inline-flex items-center gap-1 rounded-md border px-3 py-1.5 text-sm font-medium transition-colors hover:bg-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          Ansehen
        </a>
        <button
          type="button"
          id="delete-btn"
          class="inline-flex items-center gap-1 rounded-md border border-red-200 px-3 py-1.5 text-sm font-medium text-red-600 transition-colors hover:bg-red-50 dark:border-red-800 dark:text-red-400 dark:hover:bg-red-950"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18" />
            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
          </svg>
          Löschen
        </button>
      </div>
    </div>

    <div class="mb-6 flex items-center gap-3">
      <h2 class="text-2xl font-bold">{entry.name}</h2>
      <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium">
        {typeLabels[entry.type]}
      </span>
    </div>

    <EntryForm client:load entry={entry} mode="edit" />

    <div class="mt-8">
      <ImageUploadSection client:load entry={entry} />
    </div>
  </div>

  <script define:vars={{ entryType, slug }}>
    document.getElementById('delete-btn')?.addEventListener('click', async () => {
      if (!confirm('Möchten Sie diesen Eintrag wirklich als inaktiv markieren?')) {
        return;
      }

      try {
        const response = await fetch(`/api/entries/${entryType}/${slug}`, {
          method: 'DELETE',
        });

        if (response.ok) {
          window.location.href = '/admin/entries';
        } else {
          alert('Fehler beim Löschen des Eintrags');
        }
      } catch {
        alert('Ein Fehler ist aufgetreten');
      }
    });
  </script>
</AdminLayout>
