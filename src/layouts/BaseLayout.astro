---
import '@/styles/globals.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description = 'Reviews zu Restaurants, Kunst und Touren aus Lüneburg und Umgebung',
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const siteName = 'Fünf Giebel';
const siteBase = Astro.site || 'https://fuenfgiebel.de';
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const ogImageURL = image ? new URL(image, siteBase) : null;
const fullTitle = `${title} | ${siteName}`;

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/restaurants', label: 'Restaurants', color: 'magenta' },
  { href: '/kunst', label: 'Kunst', color: 'gold' },
  { href: '/touren', label: 'Touren', color: 'olive' },
];

function isActive(href: string) {
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="de_DE" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <!-- Canvas grain texture -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <header class="sticky top-0 z-40 w-full border-b border-border/40 bg-background/85 backdrop-blur-xl supports-[backdrop-filter]:bg-background/70">
      <div class="container flex h-20 items-center justify-between">
        <!-- Logo with paint accent -->
        <a href="/" class="group flex items-center gap-2.5 transition-opacity hover:opacity-80">
          <img src="/gable.svg" alt="" class="h-10 w-auto" />
          <div class="flex flex-col">
            <span class="font-serif text-xl font-semibold tracking-tight">Fünf <span class="text-magenta">Giebel</span></span>
            <span class="hidden text-[10px] font-medium uppercase tracking-widest text-muted-foreground sm:block">
              Lüneburg
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden items-center gap-1 md:flex">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'group relative px-5 py-2.5 text-sm font-medium transition-colors',
                isActive(item.href)
                  ? 'text-foreground'
                  : 'text-muted-foreground hover:text-foreground',
              ]}
            >
              {item.label}
              {isActive(item.href) && (
                <span class={`absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-${item.color}`} />
              )}
              {!isActive(item.href) && (
                <span class={`absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-${item.color} scale-x-0 transition-transform duration-300 group-hover:scale-x-100`} />
              )}
            </a>
          ))}
        </nav>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-xl text-muted-foreground transition-colors hover:bg-sand-light hover:text-foreground md:hidden"
          aria-label="Menu"
          id="mobile-menu-button"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Navigation -->
      <nav class="hidden border-t border-border/40 bg-background md:hidden" id="mobile-menu">
        <div class="container py-4 space-y-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-colors',
                isActive(item.href)
                  ? `bg-${item.color}-light text-${item.color}`
                  : 'text-muted-foreground hover:bg-sand-light hover:text-foreground',
              ]}
            >
              <span class={`h-1.5 w-1.5 rounded-full bg-${item.color}`}></span>
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-auto border-t border-border/40 bg-sand-light/30">
      <div class="container py-16 md:py-20">
        <div class="grid gap-12 md:grid-cols-3">
          <!-- Brand -->
          <div class="space-y-5">
            <div class="flex items-center gap-2.5">
              <img src="/gable.svg" alt="" class="h-8 w-auto" />
              <span class="font-serif text-lg font-semibold">Fünf <span class="text-magenta">Giebel</span></span>
            </div>
            <p class="text-sm leading-relaxed text-muted-foreground">
              Persönliche Reviews zu Restaurants, Kunst und Wanderungen aus Lüneburg und Umgebung.
            </p>
            <!-- Paint accent line -->
            <div class="flex items-center gap-2">
              <span class="h-0.5 w-8 rounded-full bg-magenta/40"></span>
              <span class="h-0.5 w-4 rounded-full bg-gold/40"></span>
              <span class="h-0.5 w-2 rounded-full bg-olive/40"></span>
            </div>
          </div>

          <!-- Navigation -->
          <div class="space-y-5">
            <h4 class="text-xs font-semibold uppercase tracking-widest text-olive">
              Kategorien
            </h4>
            <ul class="space-y-3">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group flex items-center gap-2 text-sm text-foreground/70 transition-colors hover:text-foreground"
                  >
                    <span class={`h-1 w-1 rounded-full bg-${item.color}/60 transition-all group-hover:w-3 group-hover:bg-${item.color}`}></span>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Info -->
          <div class="space-y-5">
            <h4 class="text-xs font-semibold uppercase tracking-widest text-olive">
              Rechtliches
            </h4>
            <ul class="space-y-3">
              <li>
                <a
                  href="/impressum"
                  class="group flex items-center gap-2 text-sm text-foreground/70 transition-colors hover:text-foreground"
                >
                  <span class="h-1 w-1 rounded-full bg-muted-foreground/40 transition-all group-hover:w-3 group-hover:bg-magenta"></span>
                  Impressum
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="mt-16 flex flex-col items-center justify-between gap-6 border-t border-border/40 pt-8 md:flex-row">
          <p class="text-xs text-muted-foreground">
            &copy; {new Date().getFullYear()} Fünf Giebel. Mit Liebe aus Lüneburg.
          </p>
          <div class="flex items-center gap-2 text-xs text-muted-foreground">
            <span>Bewertet mit</span>
            <div class="flex items-center gap-1">
              <img src="/gable.svg" alt="" class="h-4 w-auto" />
            </div>
            <span>Lüneburger Giebeln</span>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const menuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');

      menuButton?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
