# Data directory (where content, images, and sessions are stored)
DATA_DIR=/var/www/data

# Authentication
# Generate with: node -e "const argon2=require('argon2');argon2.hash('your-password').then(console.log)"
# Copy the full hash (including $ characters) without any quotes or escaping
# Example: ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,...
ADMIN_PASSWORD_HASH=

# External APIs (for Voice-to-Publish feature)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
NODE_ENV=development
PORT=4321
